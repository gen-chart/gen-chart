{
  "name": "gen-chart",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Typed JSON chart spec \u2192 deterministic, validated, self-contained interactive HTML charts.",
  "license": "MIT",
  "bin": {
    "gen-chart": "./bin/gen-chart.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate:validators": "node scripts/generate-validators.mjs",
    "check:validators": "node scripts/generate-validators.mjs --check",
    "render:examples": "node scripts/render-examples.mjs",
    "test": "npm run check:validators && node --test",
    "build:zip": "node scripts/build-zip.mjs",
    "test:ci": "npm run check:validators && node --test --test-concurrency=1",
    "benchmark:formats": "node scripts/benchmark-output-formats.mjs --check",
    "build:gallery": "node scripts/build-gallery.mjs"
  },
  "devDependencies": {
    "ajv": "^8.17.1"
  }
}
