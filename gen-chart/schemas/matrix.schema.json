{
  "$id": "https://gen-chart.dev/schemas/matrix.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "chart_type", "meta", "data", "mark", "encoding"],
  "properties": {
    "schema_version": { "const": 1 },
    "chart_type": { "const": "matrix" },
    "mark": { "const": "heatmap" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "$ref": "common.schema.json#/$defs/shortText" },
        "subtitle": { "$ref": "common.schema.json#/$defs/shortText" },
        "quality_profile": { "$ref": "common.schema.json#/$defs/qualityProfile" },
        "theme": { "$ref": "common.schema.json#/$defs/theme" },
        "locale": { "$ref": "common.schema.json#/$defs/locale" },
        "width": { "type": "integer", "minimum": 640, "maximum": 1600 },
        "height": { "type": "integer", "minimum": 360, "maximum": 1200 }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns"],
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 3,
          "maxItems": 12,
          "items": { "$ref": "common.schema.json#/$defs/column" }
        }
      }
    },
    "encoding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row", "column", "value"],
      "properties": {
        "row": {
          "type": "object",
          "additionalProperties": false,
          "required": ["column"],
          "properties": {
            "column": { "$ref": "common.schema.json#/$defs/id" },
            "label": { "$ref": "common.schema.json#/$defs/shortText" }
          }
        },
        "column": {
          "type": "object",
          "additionalProperties": false,
          "required": ["column"],
          "properties": {
            "column": { "$ref": "common.schema.json#/$defs/id" },
            "label": { "$ref": "common.schema.json#/$defs/shortText" }
          }
        },
        "value": {
          "type": "object",
          "additionalProperties": false,
          "required": ["column"],
          "properties": {
            "column": { "$ref": "common.schema.json#/$defs/id" },
            "label": { "$ref": "common.schema.json#/$defs/shortText" }
          }
        }
      }
    },
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["sequential", "diverging"] },
        "midpoint": { "type": "number" }
      }
    },
    "cards": { "$ref": "common.schema.json#/$defs/cards" }
  }
}
