{
  "$id": "https://gen-chart.dev/schemas/common.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
    },
    "shortText": {
      "type": "string",
      "pattern": "^.{1,120}$"
    },
    "longText": {
      "type": "string",
      "pattern": "^.{1,400}$"
    },
    "colorRole": {
      "enum": [
        "primary",
        "comparison",
        "positive",
        "negative",
        "neutral",
        "highlight"
      ]
    },
    "locale": {
      "enum": [
        "en",
        "zh-CN"
      ]
    },
    "qualityProfile": {
      "enum": [
        "standard",
        "showcase"
      ]
    },
    "theme": {
      "enum": [
        "auto",
        "light",
        "dark"
      ]
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "values"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "number",
            "date",
            "string"
          ]
        },
        "unit": {
          "$ref": "#/$defs/shortText"
        },
        "label": {
          "$ref": "#/$defs/shortText"
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5000,
          "items": {
            "type": [
              "number",
              "string",
              "null"
            ]
          }
        }
      }
    },
    "cards": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "items"
        ],
        "properties": {
          "title": {
            "$ref": "#/$defs/shortText"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "$ref": "#/$defs/longText"
            }
          }
        }
      }
    },
    "guidedViews": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "$ref": "#/$defs/shortText"
          },
          "note": {
            "$ref": "#/$defs/longText"
          },
          "focus": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "brush": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
